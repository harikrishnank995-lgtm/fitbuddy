# Copy this file to .env. Leave the API key blank to run in local demo mode.
GOOGLE_API_KEY=
# Optional overrides. Defaults use Gemini 2.5 models.
GEMINI_MODEL_WORKOUT=gemini-2.5-pro
GEMINI_MODEL_TIP=gemini-2.5-flash
DATABASE_URL=sqlite:///./fitbuddy.db

# Change these before exposing the admin dashboard.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
